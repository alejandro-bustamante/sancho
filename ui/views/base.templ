package views

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link href="/assets/css/output.css" rel="stylesheet"/>
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
		</head>
		<body class="bg-gray-100 text-gray-900 font-sans antialiased min-h-screen flex flex-col">
			<header class="bg-blue-600 text-white p-4 shadow-md">
				<div class="container mx-auto">
					<h1 class="text-2xl font-bold tracking-tight">Sancho Music</h1>
				</div>
			</header>
			
			<main class="container mx-auto p-4 mt-6 flex-grow">
				{ children... }
			</main>

			<footer class="bg-gray-800 text-white p-4 text-center mt-auto">
				<p class="text-sm">Sancho Wrapper © 2026</p>
			</footer>
		</body>
	</html>
}